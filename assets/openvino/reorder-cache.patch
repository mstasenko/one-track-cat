 namespace cldnn {
 namespace onednn {
 
+namespace {
+
+struct reorder_memory_descs {
+    dnnl::memory::desc input;
+    dnnl::memory::desc output;
+};
+
+bool is_reorder_weights(const kernel_impl_params& impl_params) {
+    return format::is_weights_format(impl_params.get_input_layout().format) ||
+           format::is_weights_format(impl_params.get_output_layout().format);
+}
+
+reorder_memory_descs get_reorder_memory_descs(const kernel_impl_params& impl_params) {
+    if (!is_reorder_weights(impl_params)) {
+        auto input_md = onednn::layout_to_memory_desc_blocked(impl_params.get_input_layout(0), dnnl::memory::format_tag::undef);
+        auto output_md = onednn::layout_to_memory_desc_blocked(impl_params.get_output_layout(), dnnl::memory::format_tag::undef);
+
+        OPENVINO_ASSERT(input_md.get_format_kind() != dnnl::memory::format_kind::any,
+                        "[GPU] The format kind of the input memory descriptor of onednn reorder cannot be 'any'.");
+        OPENVINO_ASSERT(output_md.get_format_kind() != dnnl::memory::format_kind::any,
+                        "[GPU] The format kind of the output memory descriptor of onednn reorder cannot be 'any'.");
+
+        return {input_md, output_md};
+    }
+
+    const auto& prim = impl_params.typed_desc<reorder>();
+    const auto& weights_params = prim->weights_reorder_params;
+    OPENVINO_ASSERT(weights_params != nullptr, "[GPU] Reorder weights parameters are missing.");
+    OPENVINO_ASSERT(impl_params.get_input_layout().bytes_count() == weights_params->get_input_layout().bytes_count(),
+                    "[GPU] Input layout doesn't match required reorder weights layout");
+
+    // Weight-cache imports must reuse the serialized oneDNN descriptors: reconstructing them
+    // from logical layouts loses the custom format selected when the primitive was compiled.
+    if (auto onednn_weights_params = std::dynamic_pointer_cast<WeightsReorderParamsOneDNN>(weights_params)) {
+        return {*onednn_weights_params->_in_desc, *onednn_weights_params->_out_desc};
+    }
+
+    return {onednn::layout_to_memory_desc(weights_params->get_input_layout()),
+            onednn::layout_to_memory_desc(weights_params->get_output_layout())};
+}
+
