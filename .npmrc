min-release-age=7
# Accept the pinned Vitest 4.1.12 security backport before its seven-day window.
min-release-age-exclude[]=vitest
min-release-age-exclude[]=@vitest/*
# Electron 43.8.4 includes the compromised-certificate security mitigation.
min-release-age-exclude[]=electron
# Pinned matcher/glob security fixes and their new dependencies are under seven days.
min-release-age-exclude[]=minimatch
min-release-age-exclude[]=@isaacs/nonrecursive-glob-match
min-release-age-exclude[]=glob
min-release-age-exclude[]=path-scurry
# Required peers are declared directly; omit unused Windows installer peers.
omit=peer
package-lock=false
engine-strict=true
strict-allow-scripts=true
strict-peer-deps=true
save-exact=true
allow-git=none
allow-remote=none
allow-file=none
allow-directory=none
loglevel=error
